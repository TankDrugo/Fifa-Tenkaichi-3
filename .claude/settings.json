{
  "permissions": {
    "allow": [
      "Bash(dockerd)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"$CLAUDE_PROJECT_DIR/tools/style_guard/check_output.pl\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"$CLAUDE_PROJECT_DIR/tools/style_guard/check_file_hook.pl\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null && graphify hook-guard search || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null && graphify hook-guard read || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
