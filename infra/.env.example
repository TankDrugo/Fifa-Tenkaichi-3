# Copy to infra/.env to change a default of docker-compose.yml; without it the defaults are used.
# No real secret goes in this file: it is in the repository.
POSTGRES_USER=ft3
POSTGRES_PASSWORD=ft3-dev
POSTGRES_DB=ft3
WEB_PORT=3000
REALTIME_PORT=3001
# The address the browser uses to open the WebSocket; change it with REALTIME_PORT.
REALTIME_PUBLIC_URL=ws://localhost:3001
